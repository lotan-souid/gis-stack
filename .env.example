# GIS Stack 8.0.0 — copy to .env (or paste into Portainer's stack
# "Environment variables") and replace every *_password value.
# Passwords are embedded in connection URLs: avoid @ : / ? # % in them.

# ------------------------------------------------------------------ general
# Optional services to start: basemaps (TileServer-GL), search (Solr).
# Comma-separated, e.g. COMPOSE_PROFILES=basemaps,search
COMPOSE_PROFILES=
# Host interface for published ports. 0.0.0.0 = whole LAN; 127.0.0.1 = only
# this host (e.g. when the reverse proxy runs on the same machine).
BIND_ADDR=0.0.0.0
# Where persistent data lives. Use an absolute path for Portainer git stacks.
DATA_DIR=./data

# ------------------------------------------------------------------ PostGIS
POSTGRES_DB=gisdb
POSTGRES_USER=gisadmin
POSTGRES_PASSWORD=postgres_password
POSTGIS_PORT=5433
# renovate: datasource=docker depName=postgis/postgis
POSTGIS_VERSION=17-3.5

# Read-only role used by pg_tileserv, pg_featureserv, Martin and pygeoapi
GIS_READER_USER=gis_reader
GIS_READER_PASSWORD=gis_reader_password

# MapStore's GeoStore database (created by postgis-init)
GEOSTORE_DB=geostore
GEOSTORE_USER=geostore
GEOSTORE_PASSWORD=geostore_password

# ------------------------------------------------------------------ pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@geo.local
PGADMIN_DEFAULT_PASSWORD=pgadmin_password
PGADMIN_PORT=5050
# renovate: datasource=docker depName=dpage/pgadmin4
PGADMIN_VERSION=9.14.0

# ---------------------------------------------------------------- GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver_password
GEOSERVER_PORT=8090
GEOSERVER_INITIAL_MEMORY=1G
GEOSERVER_MAX_MEMORY=2G
# renovate: datasource=docker depName=docker.osgeo.org/geoserver
GEOSERVER_VERSION=2.28.2

# ----------------------------------------------------------------- pygeoapi
PYGEOAPI_PORT=5000
# Public URL of pygeoapi (change when served through a reverse proxy)
PYGEOAPI_SERVER_URL=http://localhost:5000
# renovate: datasource=docker depName=geopython/pygeoapi
PYGEOAPI_VERSION=0.23.2

# -------------------------------------------------------------- pg_tileserv
PG_TILESERV_PORT=7800
# renovate: datasource=docker depName=pramsey/pg_tileserv
PG_TILESERV_VERSION=20250131

# ----------------------------------------------------------- pg_featureserv
PG_FEATURESERV_PORT=9000
# renovate: datasource=docker depName=pramsey/pg_featureserv
PG_FEATURESERV_VERSION=20250917

# ------------------------------------------------------------------- Martin
MARTIN_PORT=3000
# renovate: datasource=docker depName=ghcr.io/maplibre/martin
MARTIN_VERSION=1.5.0

# ---------------------------------------------------------------- MapStore2
MAPSTORE_PORT=8091
MAPSTORE_MAX_MEMORY=1g
# Initial MapStore admin — applied only on the first start (empty GeoStore DB).
# Avoid < > & in the password (written into an XML file).
MAPSTORE_ADMIN_USER=admin
MAPSTORE_ADMIN_PASSWORD=mapstore_password
# renovate: datasource=docker depName=geosolutionsit/mapstore2
MAPSTORE_VERSION=2026.01.00

# ------------------------------------------- TileServer-GL (profile: basemaps)
TILESERVER_PORT=8081
# renovate: datasource=docker depName=maptiler/tileserver-gl
TILESERVER_VERSION=v5.6.0

# ------------------------------------------------------ Solr (profile: search)
SOLR_PORT=8983
SOLR_HEAP=512m
# renovate: datasource=docker depName=solr
SOLR_VERSION=9.6.1-slim
